# Copy this file to .env and adjust values for your deployment.
# The app currently reads the secret directly from backend/auth.py for simplicity;
# for production, wire these through os.environ instead (see README "Going to production").

JWT_SECRET=change-this-to-a-long-random-string
FLASK_PORT=5055
FLASK_ENV=production

# Optional: plug in a real weather provider (see README "Live weather")
# WEATHER_API_KEY=
# WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Optional: when you migrate to PostgreSQL (see README "Migrating to PostgreSQL")
# DATABASE_URL=postgresql://user:password@localhost:5432/farmdb
